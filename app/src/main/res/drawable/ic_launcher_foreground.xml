<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: 108dp canvas, 66dp safe zone.
  Two horizontal rounded bars (the "=" mark), each 38×6.5dp, 9dp gap,
  centered, with brand gradient #FF5A00 → #FF7D1A.
  Zoomed out for refined minimalist presence and expansive safe margins.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top orange bar -->
    <group android:name="top_bar">
        <path
            android:pathData="M 37,43 L 71,43 Q 73,43 73,45 L 73,47.5 Q 73,49.5 71,49.5 L 37,49.5 Q 35,49.5 35,47.5 L 35,45 Q 35,43 37,43 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35"
                    android:startY="46.25"
                    android:endX="73"
                    android:endY="46.25"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFF5A00"/>
                    <item android:offset="1" android:color="#FFFF7D1A"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Bottom orange bar -->
    <group android:name="bottom_bar">
        <path
            android:pathData="M 37,58.5 L 71,58.5 Q 73,58.5 73,60.5 L 73,63 Q 73,65 71,65 L 37,65 Q 35,65 35,63 L 35,60.5 Q 35,58.5 37,58.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35"
                    android:startY="61.75"
                    android:endX="73"
                    android:endY="61.75"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFF5A00"/>
                    <item android:offset="1" android:color="#FFFF7D1A"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
