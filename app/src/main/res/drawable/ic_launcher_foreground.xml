<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: 108dp canvas, 66dp safe zone.
  Two horizontal rounded bars (the "=" mark), each 50×8.5dp, 13dp gap,
  centered, with brand gradient #FF5A00 → #FF7D1A.
  Zoomed out for refined proportion, breathing room, and clean masking on all launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top orange bar -->
    <group android:name="top_bar">
        <path
            android:pathData="M31.5,39 L76.5,39 Q79,39 79,41.5 L79,45 Q79,47.5 76.5,47.5 L31.5,47.5 Q29,47.5 29,45 L29,41.5 Q29,39 31.5,39 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="29"
                    android:startY="43.25"
                    android:endX="79"
                    android:endY="43.25"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFF5A00"/>
                    <item android:offset="1" android:color="#FFFF7D1A"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Bottom orange bar -->
    <group android:name="bottom_bar">
        <path
            android:pathData="M31.5,60.5 L76.5,60.5 Q79,60.5 79,63 L79,66.5 Q79,69 76.5,69 L31.5,69 Q29,69 29,66.5 L29,63 Q29,60.5 31.5,60.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="29"
                    android:startY="64.75"
                    android:endX="79"
                    android:endY="64.75"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFF5A00"/>
                    <item android:offset="1" android:color="#FFFF7D1A"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
