<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: 108dp canvas, 66-72dp safe zone.
  Two horizontal rounded bars (the "=" mark), each 58×11.5dp, 15dp gap,
  centered, with brand gradient #FF5A00 → #FF7D1A.
  Zoomed in for optimal presence and high-visibility branding on all launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top orange bar -->
    <group android:name="top_bar">
        <path
            android:pathData="M28.5,35 L79.5,35 Q83,35 83,38.5 L83,43 Q83,46.5 79.5,46.5 L28.5,46.5 Q25,46.5 25,43 L25,38.5 Q25,35 28.5,35 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="25"
                    android:startY="40.75"
                    android:endX="83"
                    android:endY="40.75"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFF5A00"/>
                    <item android:offset="1" android:color="#FFFF7D1A"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Bottom orange bar -->
    <group android:name="bottom_bar">
        <path
            android:pathData="M28.5,61.5 L79.5,61.5 Q83,61.5 83,65 L83,69.5 Q83,73 79.5,73 L28.5,73 Q25,73 25,69.5 L25,65 Q25,61.5 28.5,61.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="25"
                    android:startY="67.25"
                    android:endX="83"
                    android:endY="67.25"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFF5A00"/>
                    <item android:offset="1" android:color="#FFFF7D1A"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
